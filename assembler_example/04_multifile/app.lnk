; ============================================================
;  app.lnk — скрипт линковщика
;
;  Собирает main.obj и helper.obj в единый бинарник app.bin
;  и генерирует map-файл app.map.
; ============================================================
INPUT main.obj helper.obj
OUTPUT app.bin
MAP app.map
ORIGIN 0x0000
SIZE 0x10000
FILL 0xFF
