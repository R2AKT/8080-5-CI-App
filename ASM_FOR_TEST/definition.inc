#define CPU_Freq_kHz 2500		; Set CPU frequency to 2.5MHz for time constant's
;#define CPU_Freq_kHz 2000		; Set CPU frequency to 2.0MHz for time constant's
;#define CPU_Freq_kHz 1778		; Set CPU frequency to 1.778MHz for time constant's

;;
; Undocumented OPCODE 8080
NOP1    MACRO
        DB    08h
        ENDM
NOP2    MACRO
        DB    10h
        ENDM
NOP3    MACRO
        DB    18h
        ENDM
NOP4    MACRO
        DB    20h
        ENDM
NOP5    MACRO
        DB    28h
        ENDM
NOP6    MACRO
        DB    30h
        ENDM
NOP7    MACRO
        DB    38h
        ENDM
JMP1    MACRO
        DB    0CBh
        ENDM
CALL1   MACRO
        DB    0DDh
        ENDM
CALL2   MACRO
        DB    0EDh
        ENDM
CALL3   MACRO
        DB    0FDh
        ENDM
RET1	MACRO
        DB    0D9h
        ENDM
;;
; FIFO
USART_RX_FIFO_Addr	EQU		0081h
USART_RX_FIFO_Size	EQU		16
USART_TX_FIFO_Addr	EQU		0099h
USART_TX_FIFO_Size	EQU		16
LPT_FIFO_Addr		EQU		00B1h
LPT_FIFO_Size		EQU		80
KBD_FIFO_Addr		EQU		0109h
KBD_FIFO_Size		EQU		16
LED_FIFO_Addr		EQU		0121h
LED_FIFO_Size		EQU		16
APU_FIFO_Addr		EQU		0139h
APU_FIFO_Size		EQU		16
LCD_FIFO_Addr		EQU		0151h
LCD_FIFO_Size		EQU		80

;; RTC
;
RTC					EQU		0002h		; RTC BASE Address
RTC_Data			EQU		RTC+00h		; RTC Data Register
RTC_Addr			EQU		RTC+01h		; RTC Address Register

;;
; LCD2004
LCD2004				EQU		0000h;
LCD2004CMD			EQU		LCD2004+00h	; COMMAND Address Register
LCD2004DATA			EQU		LCD2004+01h ; DATA Address Register

;;
; Arithmetic Processing Unit (APU) - 8231 (Am9511)
APU8231 		EQU 	0030h       	; FPU8231 BASE Address
APU8231D		EQU		APU8231+00h		; FPU8231 Stack Address
APU8231SP  		EQU 	APU8231+01h 	; FPU8231 STATUS Address
APU8231CR   	EQU 	APU8231SP+00h  	; FPU8231 COMMAND Address

;;
; DMAC - DMA8237 
DMA8237 		EQU 	0000h      		; DMA8237 BASE Address
DMA8237CLR  	EQU 	DMA8237+0Dh 	; MASTER CLEAR Address
DMA8237CMD  	EQU 	DMA8237+08h 	; COMMAND Address
DMA8237MOD  	EQU 	DMA8237+0Bh 	; MODE Address
DMA8237MSK  	EQU 	DMA8237+0Fh 	; MASK Address
DMA8237CH1ADR   EQU 	DMA8237+02h 	; Ch1. ADDRESS
DMA8237CH1CNT   EQU 	DMA8237+03h 	; Ch1. COUNT
DMA8237CH2ADR   EQU 	DMA8237+04h 	; Ch2. ADDRESS
DMA8237CH2CNT   EQU 	DMA8237+05h 	; Ch2. COUNT
DMA8237CH3ADR   EQU 	DMA8237+06h 	; Ch3. ADDRESS
DMA8237CH3CNT   EQU 	DMA8237+07h 	; Ch3. COUNT
DMA8237CH4ADR   EQU 	DMA8237+08h 	; Ch.4 ADDRESS
DMA8237CH4CNT   EQU 	DMA8237+09h 	; Ch4. COUNT

;;
; USART - USART8251
USART8251   	EQU     0008h   		; USART8251 BASE Address
USART8251DATA  	EQU     USART8251+00h	; USART8251 DATA Reg.
USART8251CMD   	EQU     USART8251+01h  	; USART8251 COMMAND Reg.

;;
; TIMER - PIT8253_USART (Boudrate generator)
PIT8253_USART		EQU	000Ch       		; PIT8253 BASE Address
PIT8253_USARTCNT0	EQU	PIT8253_USART+00h	; Count 0 Register
PIT8253_USARTCNT1	EQU	PIT8253_USART+01h	; Count 1 Register
PIT8253_USARTCNT2	EQU	PIT8253_USART+02h	; Count 2 Register
PIT8253_USARTMOD	EQU	PIT8253_USART+03h	; Mode Register

;;
; TIMER - PIT8253_Smyk (Frequency generator)
PIT8253_Smyk		EQU	0054h       		; PIT8253 BASE Address
PIT8253_SmykCNT0	EQU	PIT8253_Smyk+00h	; Count 0 Register
PIT8253_SmykCNT1	EQU	PIT8253_Smyk+01h	; Count 1 Register
PIT8253_SmykCNT2	EQU	PIT8253_Smyk+02h	; Count 2 Register
PIT8253_SmykMOD		EQU	PIT8253_Smyk+03h	; Mode Register

;;
; Smyk Control - PPI8255 (Control pins)
PPI8255_Smyk	   		EQU     0050h   			; PPI8255 BASE Address
PPI8255_SmykPortA		EQU     PPI8255_Smyk+00h	; Data Port
PPI8255_SmykPortB		EQU     PPI8255_Smyk+01h 	; LSB Address Port
PPI8255_SmykPortC		EQU     PPI8255_Smyk+02h 	; MSB Address Port
PPI8255_SmykCMD 		EQU     PPI8255_Smyk+03h   	; COMMAND Address

;;
; TIMER - PIT8253 (SysTik)
PIT8253_SysTik 		EQU 	0000h       	; PIT8253 BASE Address
PIT8253_SysTikCNT0	EQU		PIT8253_SysTik+00h	; Count 0 Register
PIT8253_SysTikCNT1	EQU		PIT8253_SysTik+01h	; Count 1 Register
PIT8253_SysTikCNT2	EQU		PIT8253_SysTik+02h	; Count 2 Register
PIT8253_SysTikMOD	EQU		PIT8253_SysTik+03h	; Mode Register

;;
; TIMER - PIT8253
PIT8253 		EQU 	0000h       	; PIT8253 BASE Address
PIT8253CNT0		EQU		PIT8253+00h		; Count 0 Register
PIT8253CNT1		EQU		PIT8253+01h		; Count 1 Register
PIT8253CNT2		EQU		PIT8253+02h		; Count 2 Register
PIT8253MOD		EQU		PIT8253+03h		; Mode Register

;;
; ROM Disk (PPI8255)
ROMDisk	   		EQU     0000h   		; PPI8255 BASE Address
ROMDiskData		EQU     ROMDisk+00h		; Data Port
ROMDiskAddrLSB	EQU     ROMDisk+01h 	; LSB Address Port
ROMDiskAddrMSB	EQU     ROMDisk+02h 	; MSB Address Port
ROMDiskCMD 		EQU     ROMDisk+03h   	; COMMAND Address

;;
; PPI - PPI8255
PPI8255   		EQU     0000h   		; PPI8255 BASE Address
PPI8255A   		EQU     PPI8255+00h		; Port A Address
PPI8255B   		EQU     PPI8255+01h		; Port B Address
PPI8255C   		EQU     PPI8255+02h		; Port C Address
PPI8255CMD 		EQU     PPI8255+03h   	; COMMAND Address

;;
; DMAC - DMA8257 
DMA8257 		EQU 	0000h       	; DMA8257 BASE Address
DMA8257CLR  	EQU 	DMA8257+0Dh 	; MASTER CLEAR Address
DMA8257CMD  	EQU 	DMA8257+08h 	; COMMAND Address
DMA8257MOD  	EQU 	DMA8257+0Bh 	; MODE Address
DMA8257MSK  	EQU 	DMA8257+0Fh 	; MASK Address
DMA8257CH1ADR   EQU 	DMA8257+02h 	; Ch1. ADDRESS
DMA8257CH1CNT   EQU 	DMA8257+03h 	; Ch1. COUNT
DMA8257CH2ADR   EQU 	DMA8257+04h 	; Ch2. ADDRESS
DMA8257CH2CNT   EQU 	DMA8257+05h 	; Ch2. COUNT
DMA8257CH3ADR   EQU 	DMA8257+06h 	; Ch3. ADDRESS
DMA8257CH3CNT   EQU 	DMA8257+07h 	; Ch3. COUNT
DMA8257CH4ADR   EQU 	DMA8257+08h 	; Ch.4 ADDRESS
DMA8257CH4CNT   EQU 	DMA8257+09h 	; Ch4. COUNT

;;
; PIC (Single IRQ) - PIC8259 (IRQ0-IRQ7)
PIC8259 		EQU     0010h       	; PIC8259 BASE Address
PIC8259_CP   	EQU 	PIC8259+00h	   	; COMMAND Address
PIC8259_SP   	EQU     PIC8259+01h 	; STATUS Address

;;
; PIC (Master IRQ) - PIC8259 (0 = IRQ0-IRQ6)
PIC8259_0 		EQU     0010h       	; PIC8259 BASE Address
PIC8259_0CP   	EQU 	PIC8259_0+00h  	; COMMAND Address
PIC8259_0SP   	EQU     PIC8259_0+01h 	; STATUS Address

;;
; PIC (Slave IRQ) - PIC8259 (1 = IRQ7-IRQ14)
PIC8259_1 		EQU     0012h       	; PIC8259 BASE Address
PIC8259_1CP   	EQU 	PIC8259_1+00h  	; COMMAND Address
PIC8259_1SP   	EQU     PIC8259_1+01h 	; STATUS Address

;;
; KBD - KBD8279
KBD8279			EQU     0080h			; KBD8279 BASE Address
