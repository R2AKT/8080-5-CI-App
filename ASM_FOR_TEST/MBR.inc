; =============================================================================
; СЛУЖЕБНЫЕ КОНСТАНТЫ И ПЕРЕМЕННЫЕ ПОДСИСТЕМЫ ИНИЦИАЛИЗАЦИИ MBR
; =============================================================================
MBR_SIGNATURE_L  EQU 055H       ; Младший байт сигнатуры (0x55)
MBR_SIGNATURE_H  EQU 0AAH       ; Старший байт сигнатуры (0xAA)
VFS_REQUIRED_LBA EQU 01000H     ; Требуемый стартовый сектор раздела ФС (4096)

; Глобальные системные переменные VFS ядра в ОЗУ Ring 0
VFS_PART_START_L: DW 0000H       ; Младшие 16 бит стартового LBA раздела VFS
VFS_PART_START_H: DW 0000H       ; Старшие 16 бит стартового LBA раздела VFS
VFS_PART_TYPE:    DB 00H         ; Тип файловой системы раздела

; Временные регистры-хранители для парсинга MBR (ОЗУ Ring 0)
MBR_ENTRY_PTR:    DW 0000H       ; Указатель на текущую 16-байтовую запись раздела
MBR_SLOT_COUNTER: DB 00H         ; Счетчик просмотренных слотов (4..0)
