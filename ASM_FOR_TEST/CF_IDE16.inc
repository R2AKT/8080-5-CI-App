; Флаги регистра команд ВТ57 (DMA Command Register)
; Бит 0-3: Разрешение каналов 0..3
; Бит 4: 0 = Обычный приоритет (фиксированный), 1 = Циклический приоритет
; Бит 5: 0 = Обычная запись, 1 = Расширенная запись (Extended Write)
; Бит 6: 0 = TC STOP (Остановка по терминальному счетчику), 1 = Автозагрузка
; Нам нужен режим: Обычный приоритет, расширенная запись, остановка по TC, разрешить Канал 0
DMA_MODE_CONFIG  EQU 021H       ; Битовая маска 00100001B (Расширенная запись + Канал 0)

; =============================================================================
; КОНСТАНТЫ И ПЕРЕМЕННЫЕ МЬЮТЕКСА НАКОПИТЕЛЯ
; =============================================================================
W_CF_BUSY        EQU 05H        ; Код сна в O_WAIT_CODE: ожидание освобождения CF-карты

; Переменная защелки в ОЗУ Ядра (Ring 0)
CF_LOCK_VARIABLE: DB 00H        ; 00H = свободен, 0FFH = занят обменом
