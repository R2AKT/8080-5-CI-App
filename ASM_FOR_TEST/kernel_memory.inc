; =============================================================================
; СТРУКТУРЫ ДАННЫХ И КОНСТАНТЫ МЕНЕДЖЕРА ФИЗИЧЕСКОЙ ПАМЯТИ (ОЗУ ЯДРА)
; =============================================================================
; Предположим, на плате установлено 512 КБ физического ОЗУ (32 страницы по 16 КБ).
; Для контроля 32 страниц нам требуется ровно 4 байта (32 бита) в ОЗУ Ядра.
; Бит = 0: страница свободна, Бит = 1: страница занята процессом или ядром.
TOTAL_RAM_PAGES  EQU 32         ; Всего физических фреймов памяти по 16 КБ

RAM_BITMAP:      DB 00FH        ; Базовый байт 0 (Страницы 0..7). Биты 0,1,2,3 
                                ; изначально заняты Ядром ОС (PID=0) при старте!
                 DB 000H        ; Базовый байт 1 (Страницы 8..15)
                 DB 000H        ; Базовый байт 2 (Страницы 16..23)
                 DB 000H        ; Базовый байт 3 (Страницы 24..31)

; =============================================================================
; ГЛОБАЛЬНЫЕ СЛУЖЕБНЫЕ ПЕРЕМЕННЫЕ ПОДСИСТЕМЫ СВОПИНГА (ОЗУ ЯДРА RING 0)
; =============================================================================
SWAP_PAGE_NUM_BUF:    DB 00H    ; Физический номер фрейма ОЗУ (0..31)
SWAP_CALC_PID:        DB 00H    ; PID процесса для расчета адреса на диске
SWAP_CALC_PAGE:       DB 00H    ; Логический номер страницы (0..7) для расчета
SWAP_LBA_RESULT:      DW 0000H  ; Вычисленный 16-битный сектор LBA
SWAP_LBA_TARGET_H:    DB 00H    ; Старший байт целевого LBA для IDE
SWAP_LBA_TARGET_L:    DB 00H    ; Младший байт целевого LBA для IDE
SWAP_VICTIM_PCB_PTR:  DW 0000H  ; Базовый адрес PCB процесса-жертвы
SWAP_DIRTY_MASK_BUF:  DB 00H    ; Временный буфер маски загрязнения
SWAP_TARGET_BIT_MASK: DB 00H    ; Маска целевого бита логической страницы

; =============================================================================
; АППАРАТНЫЕ ПОРТЫ ИНТЕРФЕЙСА IDE / COMPACTFLASH (ПЛАТА eMMU)
; =============================================================================
IDE_DATA_PORT    EQU 030H       ; Регистр данных (16 бит)
IDE_SECTOR_CNT   EQU 032H       ; Счетчик секторов
IDE_LBA_LOW      EQU 033H       ; Младший байт адреса LBA (0..7)
IDE_LBA_MID      EQU 034H       ; Средний байт адреса LBA (8..15)
IDE_LBA_HIGH     EQU 035H       ; Старший байт адреса LBA (16..23)
IDE_DRV_HEAD     EQU 036H       ; Выбор диска / старшие биты LBA
IDE_CMD_STATUS   EQU 037H       ; Команда (OUT) / Статус (IN)

IDE_CMD_WRITE    EQU 030H       ; Команда IDE: Запись секторов
IDE_CMD_READ     EQU 020H       ; Команда IDE: Чтение секторов
IDE_STATUS_READY EQU 040H       ; Бит DSC + DRDY (Готовность диска)


; =============================================================================
; МОНОЛИТНЫЕ БУФЕРЫ И СЛУЖЕБНЫЕ ПЕРЕМЕННЫЕ ПОДСИСТЕМЫ ПОДКАЧКИ
; =============================================================================
; Выделяем 16 КБ непрерывного физического пространства в ОЗУ Ядра под DMA-буфер
SWAP_SYS_BUFFER:     DS 16384   ; 16 КБ буфер для асинхронного приема страниц

; Временные переменные
SWAP_IN_FRAME_BUF:   DB 00H     ; Сюда прячем целевой физический фрейм ОЗУ Ring 3
SWAP_IN_MASK_BIT:    DB 00H     ; Битовая маска текущей логической страницы
