;********************************
;     " O R I O N S O F T "
;
;    ===== ν ο ξ ι τ ο ς =====
;
;   δμρ βαϊοχοηο πλ "ORION-128"
;
;      VERSION: M4.00 BETA
;
;      οτ  23 ολτρβςρ 1994
;
;    πςογεσσος	- I8080  (Z80)
;    λμαχιατυςα - MC7007 (RK86)
;*********************************
;
ON	ASET	1
OFF	ASET	0
;
;
;-------------------------------------
;   λμαχιατυςα  νσ/ςλ
;
MS	ASET	OFF
;
;-------------------------------------
;    π/π BEEP
;
Z80CPU	ASET	ON
;
;-------------------------------------
;
STACK	EQU	0F3C0H ; ξαώ.αδς.στελα
;
;
;ποςτ KBRD
PKA	EQU	0F400H
PKB	EQU	0F401H
PKC	EQU	0F402H
PKU	EQU	0F403H
;
;ποςτ ROM-δισλ
PDA	EQU	0F500H
PDB	EQU	0F501H
PDC	EQU	0F502H
PDU	EQU	0F503H
;
;
	.PHASE	0F800H 
;
;
;
START:	JP	ST1	  ;F800
KBX:	JP	KB	  ;F803 χθ.ξα ππ οβς.λμ-ςω
	JP	RESET0    ;F806 χοσταξ.ςαβ.ρώ.νοξιτοςα
TVX:	JP	TVST	  ;F809 -"-χωχ.σινχ.ξα TV
MASC:	JP	MASC_	  ;F80C (F3C9) υπς.CURSOR
	JP	TV	  ;F80F -"-χωχ.σινχ (A)=>TV
	JP	STTS      ;F812 -"-πςOχ.στατ.λμαχ.
	JP	HEX       ;F815 -"-βακτ=>TV(2ASCII)
	JP	MSG       ;F818 -"-χωχ.σινχ.σοοβύ.
	JP	INKEY     ;F81B χχοδ λοδα ξαφ.λμαχ.
	JP	RCUR      ;F81E πομοφεξιε λυςσοςα
	JP	PUSTO     ;F821 ςεϊεςχ δμρ "PRO"/F.ROM1
	JP	CLS       ;F824
	JP	TRANS     ;F827
	JP	CSM       ;F82A σώετ λοξτς.συννω
	JP	RPAC      ;F82D ςασπαλοχλα ϊξαλ.ηεξ
	JP	PUSTO     ;F830 ςεϊεςχ δμρ "PRO"
	JP	PUSTO     ;F833 ςεϊεςχ δμρ "PRO"
	JP	RRAM      ;F836 ώτ.βακτα δοπ.στςαξ.
	JP	WRAM      ;F839 ϊπ.βακτα δοπ.στςαξ.
	JP	WCUR      ;F83C υσταξοχλα λυςσοςα
BPX:	JP	VIRUS     ;F83F χθ.χ ϊχυλ.σιξτεϊ
;
;
	DB	'V4.0'     ; χεςσιρ "V4.0"
;
; σοοβύεξιε πςι οτσυτστχ.
; ROM-δισλα
;
TABER:	DB	1FH,0AH
	DB	'M4.0/I_RK DISK?',0
;
;
ST1:	IF	Z80CPU
	LD	HL,(0F3C1H)
	LD	SP,0F3BFH
	POP	BC
	PUSH	HL
	SCF
	ADC	HL,BC	;Z80
	RET	Z
	ENDIF
;
	LD	SP,STACK
	XOR	A
	OUT	(0F8H),A     ;χωλμ.σταςτ.νεθ.
	OUT	(0F9H),A
	OUT	(0FAH),A
	OR	80H
	OUT	(0FBH),A     ;χωλμ.δισπετώες
;
        CALL	RESET   ;ιξιγιαμ.σμυφ.ρώεκλι
	CALL	RPAC    ;ςασπαλ.ϊη
;
UR:	LD	SP,STACK ;"τεπμωκ σταςτ"
;
	IF	MS
	LD	A,98H
	ELSE
	LD	A,8AH
	ENDIF

	LD	(PKU),A

ST60:	LD	A,90H
	LD	(PDU),A      ;πςοη.ποςτ ROM-DISK
	LD	HL,0
ST6:	CALL	STI
	LD	B,A
	CALL	STI
	CP	B	     ;ROM - ποδλμΰώεξ?
	JP	Z,ST2
;
	DEC	HL
	DEC	HL
	LD	A,0C3H
	CP	B
	JP	NZ,ST70
	LD	BC,0800H  ;ηςυϊιτψ βμολ ORDOS
	LD	DE,0B800H ;χ σταςον χαςιαξτε
	CALL	ST8
	JP	0BFFDH
;
; εσμι πεςχωκ βακτ ROM-δισλα ξε "C3",
; το ϊαηςυϊ. χ ξοχον ζοςνατε.
;
; 0001 0203 0405.....0F - αδς.ROM-δισλα
;  \/	\/   \/
;   I	 I    - αδς.ποσαδ.ζμ.χ οϊυ+START
;   I	  - ςαϊνες ϊαηςυφ.βμολα
;    - αδς.ςαϊνεύ.ζμ. χ ROM
;
;ξοχωκ ϊαηςυϊώιλ!!!
;
ST70:;LD	HL,(0B802H)  ;SIZE
;LD	B,H
;LD	C,L
;LD	HL,(0B804H)  ;RAM
;PUSH	HL
;EX	DE,HL
;LD	HL,(0B800H)  ;ROM
;
	CALL	STI
	LD	E,A
	CALL	STI
	LD	D,A
	CALL	STI
	LD	C,A
	CALL	STI
	LD	B,A
	PUSH	DE
	CALL	STI
	LD	E,A
	CALL	STI	
	LD	D,A
	POP	HL
	PUSH	DE
;
ST8:	CALL	STI
	LD	(DE),A
	INC	DE
	DEC	BC
	LD	A,B
	OR	C
	JP	NZ,ST8
	RET
;
STI:	LD	(PDB),HL
	LD	A,(PDA)
	INC	HL
	RET        	;47
;
ST2:	LD	HL,TABER
	CALL	MSG
	CALL	KBRD
	JP	ST60
;
; ππ.ςασπαλοχλι ZG
;
RPAC:	LD	DE,NAZG     ; 0FE4AH
	LD	HL,(ZNAK1)
ZF903:	LD	(HL),0
        INC	HL
      	LD	C,7
ZF908:	INC	DE
	LD	A,D
	OR	E
	RET	Z
	LD	A,(DE)
	RLCA
	RLCA
	RLCA
	AND	7
	INC	A
	LD	B,A
	LD	A,(DE)
	AND	1FH
ZF917:	LD	(HL),A
	INC	HL
	DEC	C
	JP	Z,ZF903
	DEC	B
	JP      NZ,ZF917
	JP	ZF908
;
KUS:
;
; βμολ ισθοδξοηο σοστορξιρ ρώ.
; MON-4. πεςεξοσιτσρ πςι "θ-σταςτε"
; χ οβμαστψ οϊυ - F3C3-F3F2H
;-----------------------
; F3C3!
;
	.DEPHASE
	.PHASE	0F3C3H
;
VIRUS:	JP	BEEP	  ;F3C3-..C5
KB:	JP	KBRD      ;F3C6-..C8
MASC_:  JP	CURSOR    ;F3C9-..CB
TVST:   JP	TV2       ;F3CC-..CE
;
EKRAN:  DB	0C0H      ;F3CF EKRAN
EKRED:  DB	30H       ;F3D0 EKRED
ZNAK1:  DW	0F000H    ;F3D1 ZG 20-7F
INVERS: DB	0         ;F3D3 INVER
SWIN:   DB	0         ;F3D4 SWIN;χωσοτα ολξα
;
PAGE:   DB	0         ;F3D5 PAGE;ξε ϊαξινατψ
;
TVAD:   DW	0         ;F3D6 TVAD
TVAD1	EQU	TVAD+1
;
ZNAK2:  DW	0F000H    ;F3D8 ZG 80-FF
;
TSU:    DB	0         ;F3DA INKEY
TSH:    DB	0         ;F3DB INKEY
TBT:    DB	0         ;F3DC ϊαξρτο MOVE,INKEY
TB1:    DB	0         ;F3DD ϊαξρτο MOVE,TVC - ςαβ. ρώεκλα
;
AR2:    DB	0         ;F3DE ESC
;
        DW	UR        ;F3DF οβς. πςες. ξε ϊαξινατψ!
;
VSTACK: DW	0         ;F3E1 σοθς. υλ. στελα
IKEYTM: DB	0   ;00H! ;F3E3 IKEYTM
;
        DB	0         ;F3E4 XCUR - ξε ισπ.
;
FFIX:   DB	0         ;F3E5 FL= RUS/LAT
SIMV:   DB	0         ;F3E6 ποσμ. χχεδ. σινχ. KBRD
CBEEP:  DB	3FH       ;F3E7 λοξστ.BEEP
TBRUS:  DW	0F800H    ;F3E8 ταβ. χεςθ. ςεη INKEY
TBLAT:  DB	0         ;F3EA σνεύ. δμρ ξιφ. ςεη
FLTABIN:DB	0         ;F3EB ζμαη ισπ. ταβμ INKEY
;
;  ζοςνιςοχαξιε ζμαηα:
; TBRUS: DW     XXXXH   ;ξαώαμο ςυσ. ταβμ.
;               +       
; TBLAT: DB	00YYH   ;σνεύεξιε
;                          
;               = ZZZZH : ξαώαμο ματ. ταβμ.
;
; FLTABIN = (LOW ZZZZH) XOR 5AH  ;ζμαη ισπ. ταβμ. INKEY
;
;
STTSV:  DW	STTS_     ;F3EC STTS
TVAV:   DW	TV_A      ;F3EE TV_A
IKEYV:  DW	I_KEY     ;F3F0 INKEY
TMKBD:  DB	2FH       ;F3F2 KBRD WAIT
;
ENDVIR:
;
	.DEPHASE
	.PHASE	KUS+ENDVIR-VIRUS
;
;---------------------------
; ππ.πεςεξοσα βμολα ισθοδ.
; σοστ.ρώ.χ οϊυ
;
RESET0:	OR	A
	RET	NZ
RESET:	LD	HL,KUS
	LD	DE,VIRUS
	LD	B,ENDVIR-VIRUS
RS:	LD	A,(HL)
	LD	(DE),A
	INC	HL
	INC	DE
	DEC	B
	JP	NZ,RS
	RET
;
;ππ.χωχοδα ξα TV
;βακτ=2ASCII
;
HEX:	PUSH	AF
	RRCA
	RRCA
	RRCA
	RRCA
	CALL	AS1
	POP	AF
AS1:	AND	0FH
	CP	0AH
	JP	M,AS2
	ADD	A,07H
AS2:	ADD	A,30H
TV20:	PUSH	BC
	LD	C,A
	CALL	TVX
	POP	BC
PUSTO:	RET            ;βμ.πυστωθ χελτοςοχ
;
;
; ππ.χωχοδ στςολι σοοβύεξιρ
;
MSG:	LD	A,(HL)
	AND	A
	RET	Z
	CALL	TV20
	INC	HL
	JP	MSG
;
;ππ ποδσώετα λοξτςομψξοκ συννω
;
;
CSM:	EX	DE,HL
	PUSH	HL
	LD	A,L
	LD	HL,0
	JP	CSM2
CSM1:	EX	DE,HL
	LD	B,(HL)
	LD	C,B
	INC	HL
	EX	DE,HL
	ADD	HL,BC
CSM2:	CP	E
	JP	NZ,CSM1
	POP	BC
	PUSH	BC
	LD	A,B
	CP	D
	LD	A,C
	JP	NZ,CSM1
	LD	A,(DE)
	ADD	A,L
	LD	C,A
	LD	B,H
	POP	HL
	RET
;
;
WCUR:	LD	A,L	  ;υστ.λυςσος
	RLCA
	RLCA
	LD	L,A
	LD	(TVAD),HL
RCUR:	LD	HL,(TVAD)	  ;ώιτ.πομοφεξιε
	LD	A,L
	RRCA
	RRCA
	LD	L,A
	RET
;
; ππ ώτεξιρ/ϊαπισι
; βακτα χ δς.στςαξιγυ
;
;
WRAM:	OUT	(0F9H),A	  ;ποςτ στςαξιγ
	LD	(HL),C
	XOR	A
	OUT	(0F9H),A
	RET
;
RRAM:	OUT	(0F9H),A
	LD	C,(HL)
	XOR	A
	OUT	(0F9H),A
	RET
;
;
; ππ ϊαπισι λοξστ.χ X-PAGE
;HL=ξ/αδς.
;DE=ςαϊνες
; C=ϊαπισωχαενωκ βακτ
; A - λυδα (PAGE) ϊαπ.βακτ
;
CLS:	AND	03
	OUT	(0F9H),A
	ADD	HL,DE	     ;HL - λ.αδς.
	EX	DE,HL
	XOR	A
	LD	A,H
	RRA
	LD	H,A
	LD	A,L
	RRA
	LD	L,A
	LD	A,C
	LD	B,H
	LD	C,L
	LD	HL,0
	ADD	HL,SP
	EX	DE,HL
	LD	SP,HL
	EX	DE,HL
	LD	D,B
	LD	E,C
	LD	C,A
	LD	B,A
CYC1:	PUSH	BC
	DEC	DE
	LD	A,D
	OR	E
	JP	NZ,CYC1
	LD	SP,HL
	LD	A,(PAGE)
	OUT	(0F9H),A
	RET
;
; ππ πεςεξοσα βμολα PAGE/PAGE
;HL=ξ/αδς.
;DE=ξ/αδς-λυδα
;BC=λομιώ.
; A=0000     - οτλυδα ώιτατψ
;	0000 - λυδα ϊαπισατψ
;  0F3D5     - PAGE_χοϊχςατ
;
TRANS:	PUSH	HL
	LD	HL,2
	ADD	HL,SP
	LD	(VSTACK),HL
	POP	HL
	LD	SP,HL        ;SP=NA_οτλυδα
	EX	DE,HL        ;HL=NA_λυδα
	AND	33H
	LD	(TBT),A      ;λυδα
	RRCA
	RRCA
	RRCA
	RRCA
	LD	(TB1),A      ;οτλυδα
;
TR0:	OUT	(0F9H),A
	POP	DE
	LD	A,(TBT)
	OUT	(0F9H),A
	LD	(HL),E
	INC	HL
	DEC	BC
	LD	A,B
	OR	C
	JP	Z,TR1
	LD	(HL),D
	INC	HL
	DEC	BC
	LD	A,B
	OR	C
	LD	A,(TB1)
	JP	NZ,TR0
TR1:	LD	A,(PAGE)
	OUT	(0F9H),A
	LD	HL,(VSTACK)
	LD	SP,HL       ;χοστ.στελ
	RET
;
; ππ οβςαβοτλι λμαχ-ςω
; (οβύαρ δμρ RK86 ι νσ7007)
; χωχοδ σινχ.πο ξαφατιΰ
;
;---------------------------------------
;---------------------------------------
;π/π 0F803H ιϊ MON-3
;  
;---------------------------------------
;---------------------------------------
;
KBRD:	PUSH	BC
	PUSH	DE
	PUSH	HL
	LD	HL,STR2
	PUSH	HL
ZFCEE:	LD	DE,0FFH
ZFCF1:	CALL	ZFD3D
	LD	B,A
	LD	HL,VSTACK
	INC	A
	JP	NZ,ZFCFF
ZFCFB:	LD	(HL),1
	JP	ZFCF1
;
ZFCFF:	LD	C,(HL)
ZFD00:	XOR	A
ZFD01:	DEC	A
	JP	NZ,ZFD01
	CALL	ZFD3D
	CP	B
	JP	NZ,ZFCFB
	DEC	C
	JP	NZ,ZFD00
	DEC	(HL)
	LD	A,(TMKBD)
	LD	(HL),A
	JP	Z,ZFD16
	LD	(HL),2
ZFD16:	LD	A,D
	RRCA
	CALL	C,MASC
	CALL	BPX
	LD	A,B
	LD	(SIMV),A
	CP	0FEH
	RET	NZ
	LD	HL,CBEEP
	LD	A,(HL)
	XOR	1FH
	LD	(HL),A
	LD	HL,FFIX
	LD	A,(HL)
	CPL
	LD	(HL),A
RLT:    CALL	INKEY
	CP	0FEH
	JP	Z,RLT
	CALL	BPX
	JP	ZFCEE
;
ZFD3D:	INC	DE
	INC	E
	DEC	E
	CALL	Z,MASC
	JP	INKEY
;
; ππ χλμ/χωλμ λυςσοςα
;
CURSOR:	PUSH	BC
	PUSH	HL
	CALL	MASC1
	ADD	A,9
	LD	L,A
	LD	A,B
	XOR	(HL)
	LD	(HL),A
	INC	H
	LD	A,C
	XOR	(HL)
	LD	(HL),A
	POP	HL
	POP	BC
	RET
;
MASC1:	LD	HL,(TVAD)
	LD	A,L
	RRCA
	LD	L,A
	RRCA
	ADD	A,L
	LD	B,A
	LD	L,H
	LD	A,(EKRAN)
	LD	H,A
	LD	A,B
	DEC	H
M18:	INC	H
	SUB	04H
	JP	NC,M18
	LD	(TB1),A
	PUSH	HL
	LD	HL,0FCH
M19:	ADD	HL,HL
	ADD	HL,HL
	INC	A
	JP	NZ,M19
	LD	B,H
	LD	C,L
	POP	HL
MULT10:	LD	A,L
	RLCA
	RLCA
	RLCA
	ADD	A,L
	ADD	A,L
	LD	L,A
	RET
;
;
;
IF	MS
;
;
;
;&=========================
; σνεξξωε δςακχεςω λμαχ-ςω
;---δμρ ςλ86 ποσμε END!!---
;==========================
;
; ππ.στατυσ KBRD
STTS:	PUSH	HL
	LD	HL,(STTSV)
	EX	(SP),HL
	RET
;
STTS_:	XOR	A
	LD	(PKC),A
	LD	(PKB),A
	LD	A,(PKA)
	INC	A
	RET	Z
;
	LD	A,0FFH
	LD	(PKC),A
	LD	A,0FCH   ; 1-2?
	LD	(PKB),A
	LD	A,(PKA)
	AND	0EBH
	CP	0EBH
	JP	NZ,STS1
;
	LD	A,3      ; 3-8?
	LD	(PKB),A
	LD	A,(PKA)
	INC	A
	JP	NZ,STS1
;
	LD	(PKC),A      ; 9-11?
	LD	A,(PKA)
	INC	A
	JP	NZ,STS1
	RET
;
STS1:	LD	A,0FFH
	RET
;
; ππ.οπςοσα νατςιγω
; λμαχιατυςω
;
INKEY:	PUSH	HL
	LD	HL,(IKEYV)
	EX	(SP),HL
	RET
;
I_KEY:	PUSH	BC
	PUSH	DE
	PUSH	HL
	LD	HL,STR2
	PUSH	HL

;LD	HL,(TBRUS)
;EX	DE,HL
;LD	HL,TBLAT
;LD	C,(HL)
;EX	DE,HL
;LD	B,0
;ADD	HL,BC
;EX	DE,HL
;INC	HL
;LD	A,(HL)	
;XOR	5AH
;CP	E
;JP	Z,INTABL
;
;
;ORDINARY INKEY FOR MS7007
;
;
INTABL: LD	HL,0FFFFH
	LD	(TSU),HL
	LD	(TSH),HL
	DEC	HL
	LD	C,0
KEY:	LD	(PKB),HL
	LD	A,(PKA)
	CP	0FFH
	JP	Z,KEY4
	LD	B,A
;
	PUSH	HL
	LD	H,5
	LD	A,(IKEYTM)
KYT:	DEC	A
	JP	NZ,KYT
	DEC	H
	JP	NZ,KYT
	POP	HL
;
	LD	A,(PKA)
	CP	B
	JP	NZ,KEY4
;
KEY2:	LD	B,C
	JP	KEY5
KEY3:	INC	C
KEY5:	RRA
	JP	C,KEY3
	LD	A,C
	LD	C,B
	LD	DE,TSU
	CP	0AH  ; συ
	JP	Z,SKL
	CP	4	 ; SHIFT
	INC	DE
	JP	Z,SKL
	CP	14H  ; ζιλσ
	JP	Z,FX
	INC	DE
	DEFB	6	 ; MVI B,0AFH - πυστ. λον.
;
SKL:	XOR	A
	LD	(DE),A
;
KEY4:	LD	A,C
	ADD	A,8
	LD	C,A
	SCF
	LD	A,L
	RLA
	LD	L,A
KEY1:	LD	A,H
	RLA
	LD	H,A
	CP	0F7H
	JP	NZ,KEY
	LD	A,(TBT)
	CP	0FFH
	RET	Z
;
	LD	HL,(TBRUS)
	EX	DE,HL
	LD	HL,(TBRUS)
	LD	A,(TBLAT)
	LD	C,A
	LD	B,0
	ADD	HL,BC

	LD	A,(FFIX)
	AND	A
	JP	Z,KEY6
	EX	DE,HL
KEY6:	LD	A,(TSH)
	AND	A
	JP	NZ,KEY61
	EX	DE,HL
KEY61:	LD	B,0
	LD	A,(TBT)
	LD	C,A
	ADD	HL,BC
	LD	A,(TSU)
	AND	A
	LD	A,(HL)
	RET	NZ
	AND	1FH
	RET
;
FX:	LD  	A,0FEH
	RET
;
;
;
ELSE
;
;
;&------------------------
; PR_KB, STTS, INKEY δμρ
; MON V4.0/RK
;-------------------------
;
; ππ.στατυσ λμαχιατυςω
STTS:	PUSH	HL
	LD	HL,(STTSV)  ;ρώ.πεςεξαϊξαώεξιρ
	EX	(SP),HL
	RET
;
STTS_:;CALL	INTRRP
STAT:   XOR	A	   ;STTS - RK86
	LD	(PKA),A
	LD	A,(PKB)
	INC	A
	RET	Z
	OR	0FFH
	RET
;
; ππ οπςοσα νατςιγω
; λμαχιατυςω (RK86)
INKEY:	PUSH	HL
	LD	HL,(IKEYV)  ;ρώ.πεςεξαϊξαώεξιρ
	EX	(SP),HL
	RET
;
;INTRRP: LD	A,(PKC)
;AND	60H
;RET	NZ
;CALL	ZFD4C
;INC	A
;JP	Z,INTRRP
;INC	A
;RET	NZ
;ZFAFC:	CALL	ZFD4C
;CP	0DH
;JP	NZ,ZFAFC
;ZFB03:  CALL	STAT 
;JP	NZ,ZFB03
;RET
;
;
;
I_KEY:;CALL	INTRRP
;
ZFD4C:	PUSH	BC
	PUSH	DE
	PUSH	HL
	LD	HL,STR2
	PUSH	HL

;LD	HL,(TBRUS)
;EX	DE,HL
;LD	HL,TBLAT
;LD	C,(HL)
;EX	DE,HL
;LD	B,0
;ADD	HL,BC
;EX	DE,HL
;INC	HL
;LD	A,(HL)
;XOR	5AH
;CP	E
;JP	Z,INTABL
;
;ORDINARY INKEY
;
