;TABLE INKEY
;
INTABL: LD	HL,TSU
	LD	BC,00FFH
	LD	A,(PKC)
	RLA
	JP	C,K00
	LD	A,C
	DEC	A
	RET
;
K00:	RLA
	LD	(HL),C
	JP	C,K01
	LD	(HL),B      ;υσ (TSU)
K01:	INC	HL
	RLA
	LD	(HL),C
	JP	C,K1
	LD	(HL),B      ;σσ (TSH)
;
K1:	DEC	C
	LD	D,09H
K2:	LD	A,C
	LD	(PKA),A
	RLCA
	LD	C,A
;
K3:	LD	A,(PKB)
	CP	0FFH
	JP	Z,K4
	LD	E,A
;
;INKEY_TIME
;
	LD	H,5
	LD	A,(IKEYTM)
KYT:	DEC	A
	JP	NZ,KYT
	DEC	H
	JP	NZ,KYT
;
	LD	A,(PKB)
	CP	E
	JP	Z,K5
;
K4:	LD	A,B
	ADD	A,08H
	LD	B,A
	DEC	D
	JP	NZ,K2
;
;χωθ.εσμε ξετ ξαφ.λμαχ.
;
	OR	0FFH
	RET
;
K50:	INC	B
K5:	RRA
	JP	C,K50
;
;B= N KEY
;
	LD	A,B
	LD	(TBT),A
	PUSH	AF
	LD	HL,(TBRUS)
	EX	DE,HL
	LD	HL,(TBRUS)
	LD	A,(TBLAT)
	LD	C,A
	LD	B,0
	ADD	HL,BC
	POP	BC
	LD	A,(FFIX)
	AND	A
	JP	Z,K6
	EX	DE,HL
K6:	LD	A,(TSH)
	AND	A
	JP	NZ,K61
	EX	DE,HL
K61:	LD	C,B
	LD	B,0
	ADD	HL,BC
	LD	A,(TSU)
	AND	A
	LD	A,(HL)
	JP	NZ,STR2
	AND	1FH
	RET
;
;-----------------------
;
;
ENDIF
