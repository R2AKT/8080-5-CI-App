;==========================
; ππ.χωχοδα σινχομα ξα TV
; α => TV
;
TV:	PUSH	HL
	LD	HL,(TVAV)
	EX	(SP),HL
	RET
;
TV_A:	PUSH	BC
	LD	C,A
	DEFB	6
;
; C => TV
;
TV2:	PUSH	BC
TBC:	PUSH	DE
	PUSH	HL
	PUSH	AF

;IFE	MS
;CALL	INTRRP
;ENDIF

	LD	A,C 
	CP	1BH
	LD	A,0F0H
	JP	Z,UPR1
	LD	A,(AR2)
	AND	A
	JP	NZ,UST
ARINT:	LD	A,C
;
	CP	7	     ;BEEP ?
	JP	NZ,VT10
	CALL	BPX
	JP	EXX4
;
VT10:	CP	7FH
	JP	NZ,VT14
	LD	HL,INVERS
	LD	A,(HL)
	CPL
	LD	(HL),A
	JP	EXX4
;
VT14:	RLCA
	LD	A,C
	JP	NC,MMM1
	LD	HL,(ZNAK2)   ;αδςεσ ϊη: 80-FF
	EX	DE,HL
	LD	H,80H
	SUB	H
	JP	MMM2
;
MMM1:	LD	HL,(ZNAK1)   ;αδςεσ ϊη: 20-7F
	EX	DE,HL
	LD	H,20H
	SUB	H
	JP	C,OP1	     ;<= A<20H
;
MMM2:	LD	L,A
	ADD	HL,HL
	ADD	HL,HL
	ADD	HL,HL	     ;*8
	EX	DE,HL
	ADD	HL,DE
	EX	DE,HL
	CALL	MASC1
	EX	DE,HL
	LD	A,16H
V22:	PUSH	AF  
	PUSH	HL
	LD	A,(INVERS)
	XOR	(HL)
	AND	3FH
	LD	L,A
	LD	A,(TB1)
	DEC	A
	LD	H,0H
V21:	ADD	HL,HL
	ADD	HL,HL
	INC	A
	JP	NZ,V21
	EX	DE,HL
	LD	A,B
	XOR	(HL)
	AND	(HL)
	OR	D
	LD	(HL),A
	INC	H
	LD	A,C
	XOR	(HL)
	AND	(HL)
	OR	E
	LD	(HL),A
	DEC	H
	INC	L
	EX	DE,HL
	POP	HL
	INC	HL
	POP	AF
	SUB	03H
	JP	P,V22
	LD	HL,OPER+1
	CP	0F8H
	JP	NZ,V22
OP1:	LD	HL,(TVAD)
	CALL	OPER
	ADD	HL,BC
	LD	A,H
	CP	19H
	JP	C,V3
	JP	NZ,V4
	INC	D
	LD	H,D
	JP	Z,V3
;
;	   SCROLL
;
	PUSH	HL
	LD	HL,0H
	ADD	HL,SP
	LD	(VSTACK),HL
	LD	A,(EKRED)
	LD	B,A
	LD	A,(EKRAN)
	LD	H,A
	LD	A,(SWIN)
	LD	L,A
	CALL	MULT10
	LD	C,A
RL0:	LD	A,C
	ADD	A,0AH
	LD	L,A
	LD	SP,HL
	LD	L,C
	LD	A,0F0H
RL1:	POP	DE
	LD	(HL),E
	INC	L
	LD	(HL),D
	INC	L
	POP	DE
	LD	(HL),E
	INC	L
	LD	(HL),D
	INC	L
	CP	L
	JP	NC,RL1
	LD	A,(INVERS)
RL2:	INC	SP
	LD	(HL),A
	INC	L
	JP	NZ,RL2
	INC	H
	DEC	B
	JP	NZ,RL0
	LD	HL,(VSTACK)
	LD	SP,HL
	POP	HL
V4:	LD	H,18H
V3:	LD	(TVAD),HL
EXX4:	POP	AF
STR2:	POP	HL
	POP	DE
	POP	BC
	RET
;
OPER:	LD	BC,100H
	LD	D,C
	INC	A
	CALL	Z,GTV
	JP	Z,V5
	CP	0EBH
	RET	Z
	DEC	D
	ADD	A,5H
	RET	Z
	INC	D
	LD	B,0FFH
	INC	A
	RET	Z
	LD	C,0FCH
	CP	0EFH
	RET	Z
	LD	BC,0H
	CP	0F0H
	JP	NZ,VDOP
	LD	A,L
	AND	0E0H
	ADD	A,20H
	LD	L,A
	RET
;
VDOP:	LD	C,04H
	INC	A
	RET	Z
V6:	ADD	A,0BH
	JP	Z,V7
	INC	A
	RET	NZ
V5:	LD	H,D
V7:	LD	L,D
	LD	B,D
	LD	C,D
	RET
;
UST1:	LD	A,C
	CP	59H
	JP	NZ,UST2
	LD	A,02H
	OR	B
UPR1:	LD	(AR2),A
	JP	EXX4
;
UST:	LD	B,A
	AND	03H
	JP	Z,UST1
	DEC	A
	JP	Z,MEST
	DEC	A
	JP	Z,STROK
UST2:	XOR	A
	LD	(AR2),A
	LD	A,C
	CP	4AH
	JP	Z,SNC
	CP	4BH
	JP	Z,SPC
	LD	HL,ARINT
	PUSH	HL
	LD	HL,ARINT
	PUSH	HL
	LD	C,18H
	CP	43H
	RET	Z
	INC	C
	CP	41H
	RET	Z
	INC	C
	CP	42H
	RET	Z
	LD	C,08H
	CP	44H
	RET	Z
	LD	C,0CH
	CP	48H
	RET	Z
	LD	C,1FH
	CP	45H
	RET	Z
	CP	C
	RET	Z
	POP	HL
	JP	EXX4
;
MEST:	LD	A,C
	SUB	20H
	RLCA
	RLCA
	AND	0FCH
	LD	(TVAD),A
	XOR	A
	JP	UPR1
;
STROK:	LD	A,C
	SUB	20H
	LD	(TVAD1),A
	LD	A,0F1H
	JP	UPR1
;
; ππ οώιστλι όλςαξα
;
GTV:	PUSH	BC
	PUSH	DE
	PUSH	HL
	PUSH	AF
	LD	A,(SWIN)
	JP	SNSZ
;
SNC:	LD	A,(TVAD1)	 ;στες.ξιφ.λυςσ.
	INC	A
SNSZ:	CP	19H
	JP	NC,EXX4
	LD	L,A
	CALL	MULT10
	LD	C,A
	LD	A,(EKRAN)
	LD	H,A
	LD	A,(EKRED)
	LD	B,A
	DEC	H
SNC2:	INC	H
	LD	L,C
	LD	A,(INVERS)
SNC3:	LD	(HL),A
	INC	L
	JP	NZ,SNC3
	DEC	B
	JP	NZ,SNC2
	JP	EXX4
;
SPC:	LD	HL,(TVAD)	 ;στες.πςαχ.λυςσ.
	PUSH	HL
	LD	B,L
	LD	C,20H
SPC1:	CALL	TV2
	LD	A,04H
	ADD	A,B
	LD	B,A
	JP	NZ,SPC1
	POP	HL
	JP	V3
;
;
IF	Z80CPU
;
; ππ.BEEP δμρ "CARD2+Z80"
;
BEEP:	PUSH	BC
	LD	C,20H
BP1Z:   LD	A,(CBEEP)
	OUT	(0FFH),A
BP2Z:	DEC	A
	JP	NZ,BP2Z
	DEC	C
	JP	NZ,BP1Z
	POP	BC
	RET
;
ELSE
;
;
BEEP:	PUSH	BC
        LD 	C,20H
BP1:	LD	A,(CBEEP)
BP2:	EI
        DCR	A
	JP	NZ,BP2
	LD	A,(CBEEP)
BP3:	DI
	DCR	A
	JP	NZ,BP3
	DCR	C
	JP	NZ,BP1
	POP	BC
	RET
;
ENDIF
