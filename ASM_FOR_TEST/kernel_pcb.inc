; Смещение (Байт)  Размер   Имя поля            Описание и назначение для ядра POSIX
; -------------------------------------------------------------------------------------------------
; +0               1 B      O_PID               Идентификатор процесса (0 = Ядро, 1..254 = Задачи)
; +1               1 B      O_PPID              PID родителя (нужен для waitpid)
; +2               1 B      O_STATUS            Статус (FREE, CREATED, READY, RUNNING, WAITING, ZOMBIE)
; +3               2 B      O_SAVED_SP          Сохраненный указатель стека Ring 3 на момент прерывания
; +5               1 B      O_SYSCALL_RES       Код результата системного вызова / код возврата exit
; +6               1 B      O_UID               Идентификатор пользователя (User ID, 0 = ROOT)
; +7               1 B      O_GID               Идентификатор группы (Group ID)
; +8               4 B      O_PAGES_MAP         [ФИЗИЧЕСКИЕ] Номера физ. страниц ОЗУ для Сегментов 0–3
; +12              4 B      O_EXT_PAGES_MAP     [ВИРТУАЛЬНЫЕ] Страницы расширения (Сегменты 4–7 для оверлеев)
; +16              1 B      O_CF_SWAP_MASK      Битовая маска сегментов процесса в свопе на CF-карте
; +17              2 B      O_CWD_INODE         Номер сектора/инноды текущей директории процесса на CF
; +19              1 B      O_UMASK             Маска прав создания файлов (POSIX umask, дефолт 022)
; +20              8 B      O_FILE_TABLE        Таблица дескрипторов файлов (8 слотов: FD 0..7). 
                                              ; Значение - индекс в глобальной таблице файлов ядра (0xFF=свободен)

; ; === БЛОК ПЛАНИРОВАНИЯ И ПРИОРИТЕТОВ POSIX ===
; +28              1 B      O_PRIO_STATIC       Статический (базовый) приоритет процесса (0-255)
; +29              1 B      O_PRIO_NICE         Пользовательская nice-поправка (POSIX nice, 0-40, дефолт 20)
; +30              1 B      O_PRIO_DYNAMIC      Вычисляемый планировщиком динамический приоритет
; +31              1 B      O_CPU_TICKS         Штрафной счетчик времени, проведенного процессом на CPU

; ; === БЛОК АСИНХРОННЫХ СИГНАЛОВ И ТАЙМЕРОВ ===
; +32              2 B      O_SIG_PENDING       16-битная маска ожидающих доставку сигналов (POSIX)
; +34              2 B      O_SIG_BLOCKED       16-битная маска временно заблокированных сигналов
; +36              2 B      O_SIG_TABLE_PTR     Системный указатель на векторы обработчиков sigaction
; +38              2 B      O_ALARM_TICKS       Будильник POSIX таймера в 100-мс тиках (вызов alarm)
; +40              1 B      O_WAIT_CODE         wait-channel (причина блокировки процесса в ST_WAITING)
; +41 			   1 B      O_PAGE_DIRTY_MASK   Битовая маска (8 бит для 8 страниц процесса).
;												1 = страница изменена (грязная), 0 = страница чистая (совпадает с диском).
; +42              22 B     O_RESERVED_PAD      Чистый выравнивающий резерв ядра до границы ровно 64 байт
; -------------------------------------------------------------------------------------------------
; ИТОГО: 64 байта (2^6). За счет этого размер в коде переключения процессов вычисляется через 6 сдвигов (PID << 6).
;;
; =============================================================================
; АКТУАЛЬНАЯ РАЗМЕТКА СТРУКТУРЫ PCB ЯДРА eMMU POSIX (64 БАЙТА)
; =============================================================================
PCB_SIZE         EQU 64      ; Жесткий размер структуры процесса (PID << 6)
MAX_PROCS        EQU 254     ; Ограничение PID (0=Ядро, 1..254=Задачи)
RES_FREE_MARKER  EQU 0FFH    ; Маркер свободного устройства в глобальной таблице

; --- ОФИЦИАЛЬНЫЕ СМЕЩЕНИЯ ПОЛЕЙ ВНУТРИ СТРУКТУРЫ PCB ---
O_PID            EQU 0       ; Идентификатор текущего процесса [1 байт]
O_PPID           EQU 1       ; Идентификатор родительского процесса [1 байт]
O_STATUS         EQU 2       ; POSIX статус жизненного цикла [1 байт]
O_SAVED_SP       EQU 3       ; Сохраненный указатель стека задачи [2 байта]
O_SYSCALL_RES    EQU 5       ; Переменная кода результата syscall / exit [1 байт]
O_UID            EQU 6       ; User ID процесса (0 = суперпользователь) [1 байт]
O_GID            EQU 7       ; Group ID процесса [1 байт]
O_PAGES_MAP      EQU 8       ; Номера физ. страниц ОЗУ для Сегментов 0–3 [4 байта]
O_EXT_PAGES_MAP  EQU 12      ; Номера расширенных страниц для Сегментов 4–7 [4 байта]
O_CF_SWAP_MASK   EQU 16      ; Битовая маска страниц в свопе на CF-карте [1 байт]
O_CWD_INODE      EQU 17      ; Текущая рабочая директория процесса [2 байта]
O_UMASK          EQU 19      ; Маска прав создания новых файлов umask [1 байт]
O_FILE_TABLE     EQU 20      ; Таблица дескрипторов файлов (8 слотов по 1B) [8 байт]
; Смещения блока приоритетов (Смещены из-за удаления таблицы устройств на 32 байта)
O_PRIO_STATIC    EQU 28      ; Статический базовый приоритет [1 байт]
O_PRIO_NICE      EQU 29      ; Пользовательская nice-поправка (0-40, деф 20) [1 байт]
O_PRIO_DYNAMIC   EQU 30      ; Динамический приоритет для планировщика [1 байт]
O_CPU_TICKS      EQU 31      ; Штрафной счетчик квантов времени процессора [1 байт]
; Смещения блока сигналов
O_SIG_PENDING    EQU 32      ; Маска ожидающих сигналов (POSIX) [2 байта]
O_SIG_BLOCKED    EQU 34      ; Маска заблокированных сигналов [2 байта]
O_SIG_TABLE_PTR  EQU 36      ; Системный указатель на векторы sigaction [2 байта]
O_ALARM_TICKS    EQU 38      ; Тики будильника для системного вызова alarm [2 байта]
O_WAIT_CODE      EQU 40      ; wait-channel (код причины сна задачи) [1 байт]
O_PAGE_DIRTY_MASK	EQU 41   ; Битовая маска (8 бит для 8 страниц процесса).
;							   1 = страница изменена (грязная), 0 = страница чистая (совпадает с диском).
O_RESERVED_PAD   EQU 42      ; Резервное жесткое выравнивание структуры [23 байта]

; --- ОФИЦИАЛЬНЫЕ POSIX-СТАТУСЫ ЖИЗНЕННОГО ЦИКЛА ПРОЦЕССА ---
ST_FREE          EQU 00H     ; Слот PCB полностью свободен (доступен для fork)
ST_CREATED       EQU 01H     ; Создаётся (ресурсы взяты, идёт загрузка образа в ОЗУ)
ST_READY         EQU 02H     ; Готов к исполнению (находится в очереди планировщика)
ST_RUNNING       EQU 03H     ; Выполняется на CPU в данный момент (активный контекст)
ST_WAITING       EQU 04H     ; Ожидает ввода-вывода / заблокирован на wait-channel
ST_ZOMBIE        EQU 05H     ; Завершен (ОЗУ свободно, ждет waitpid от родителя)

; Маски критических сигналов
SIGKILL_MASK_H   EQU 02H     ; 9-й сигнал (1-й бит старшего байта маски)
SIGALRM_MASK_H   EQU 40H     ; 14-й сигнал (6-й бит старшего байта маски)
