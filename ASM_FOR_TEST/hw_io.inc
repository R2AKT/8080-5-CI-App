; =============================================================================
; АДРЕСА ПОРТОВ ПЕРИФЕРИИ И АППАРАТНЫЕ КОНСТАНТЫ СИСТЕМЫ eMMU / POSIX
; =============================================================================
MASTER_8259_DATA EQU 0A0H    ; КР580ВН59 — Порт данных
MASTER_8259_CMD  EQU 0A1H    ; КР580ВН59 — Порт команд/статуса
SYS_PIT_CH0      EQU 0B0H    ; КР580ВИ53 №1 — Канал 0 (вход системный 1 МГц -> выход IR0)
SYS_PIT_CMD      EQU 0B3H    ; КР580ВИ53 №1 — Управляющий порт
UART_PIT_CH0     EQU 0C0H    ; КР580ВИ53 №2 — Канал 0 (тактирование RxC ВВ51А)
UART_PIT_CH1     EQU 0C1H    ; КР580ВИ53 №2 — Канал 1 (тактирование TxC ВВ51А)
UART_PIT_CMD     EQU 0C3H    ; КР580ВИ53 №2 — Управляющий порт
UART_DATA        EQU 080H    ; КР580ВВ51А — Порт данных
UART_CMD         EQU 081H    ; КР580ВВ51А — Порт команд/статуса
DMA_CH0_ADDR     EQU 020H       ; Канал 0: Регистр текущего адреса (2 байта последовательно)
DMA_CH0_COUNT    EQU 021H       ; Канал 0: Счетчик терминальных циклов (2 байта)
DMA_CMD_STATUS   EQU 028H       ; Управляющий регистр (OUT) / Регистр статуса (IN)

