; =============================================================================
; РАСШИРЕННЫЕ ИДЕНТИФИКАТОРЫ (НОМЕРА) СИСТЕМНЫХ ВЫЗОВОВ POSIX
; =============================================================================
;DEF_SYS_FORK			EQU 0          ; Порождение нового процесса (fork)
;DEF_SYS_EXIT			EQU 1          ; Завершение текущего процесса (exit)
;DEF_SYS_WAITPID		EQU 2          ; Сбор статусов завершенных процессов (waitpid)
;DEF_SYS_REQUEST_IO		EQU 3          ; Захват порта ввода-вывода (request_io)
;DEF_SYS_RELEASE_IO		EQU 4          ; Освобождение порта ввода-вывода (release_io)
;DEF_SYS_OPEN			EQU 5          ; Открытие файла / устройства (open)
;DEF_SYS_CLOSE			EQU 6          ; Закрытие файла / устройства (close)
;DEF_SYS_READ			EQU 7          ; Чтение из дескриптора (read)
;DEF_SYS_WRITE			EQU 8          ; Запись в дескриптор (write)
;DEF_SYS_CHDIR			EQU 9          ; Смена рабочей директории (chdir)
;DEF_SYS_ALARM			EQU 10         ; Постановка POSIX-будильника (alarm)
;DEF_SYS_SIGACTION		EQU 11         ; Регистрация обработчика сигнала (sigaction)
;DEF_SYS_EXECVE			EQU 12         ; Загрузка и запуск нового бинарника (execve)
;DEF_SYS_OVERLAY_MAP	EQU 13		   ; Программный маппинг сегментов 4-7 (overlay)


MAX_SYSCALL_NUM			EQU 13         ; Размер таблицы переходов системных вызовов
ENOSYS           		EQU 0xE5  	   ; Возвращает ошибку (0xE5)

; =============================================================================
; СЛУЖЕБНЫЕ ПЕРЕМЕННЫЕ ЯДРА ДЛЯ СИСТЕМНОГО ВЫЗОВА SYS_FORK (ОЗУ RING 0)
; =============================================================================
FORK_CHILD_PID:  DB 00H         ; Хранилище выделенного PID для потомка
FORK_CHILD_PCB:  DW 0000H       ; Базовый адрес структуры PCB потомка
FORK_SRC_PTR:    DW 0000H       ; Текущий логический адрес чтения памяти родителя
FORK_DST_PTR:    DW 0000H       ; Текущий адрес записи в окне Сегмента 2 потомка
FORK_TEMP_PAGES: DB 0FFH, 0FFH, 0FFH, 0FFH ; Буфер под 4 выделенные физ. страницы

; =============================================================================
; ВРЕМЕННЫЕ ЯЧЕЙКИ ПАМЯТИ ЯДРА ДЛЯ ОПЕРАЦИИ ЗАПИСИ (ОЗУ RING 0)
; =============================================================================
WRITE_BYTES_COUNT: DB 00H
WRITE_TEMP_HL:     DW 0000H

; =============================================================================
; ВРЕМЕННЫЕ ЯЧЕЙКИ ПАМЯТИ АЛЛОКАТОРА ЧТЕНИЯ В ОЗУ ЯДРА (RING 0)
; =============================================================================
READ_BYTES_COUNT: DB 00H
READ_TEMP_HL:     DW 0000H

; =============================================================================
; ВРЕМЕННЫЕ ЯЧЕЙКИ ОЗУ ЯДРА ДЛЯ ОПЕРАЦИИ ЗАВЕРШЕНИЯ ПРОЦЕССА (RING 0)
; =============================================================================
EXIT_TEMP_CODE:  DB 00H
EXIT_PARENT_PID: DB 00H

; =============================================================================
; ВРЕМЕННЫЕ СИСТЕМНЫЕ ПЕРЕМЕННЫЕ ВЫЗОВА WAITPID В ОЗУ ЯДРА (RING 0)
; =============================================================================
WAIT_USER_STATUS_PTR: DW 0000H
WAIT_TARGET_PID_H:    DB 00H
WAIT_TARGET_PID_L:    DB 00H
WAIT_HAS_CHILDREN:    DB 00H
WAIT_TEMP_EXIT_CODE:  DB 00H

; =============================================================================
; ВРЕМЕННЫЕ СТРУКТУРЫ ДАННЫХ И БУФЕРЫ ЯДРА (ОЗУ RING 0)
; =============================================================================
EXEC_ARGV_PTR:       DW 0000H
EXEC_START_SECTOR:   DB 00H
IDE_SYS_BUFFER:      DS 512     ; Системный секторный буфер ввода-вывода ядра

; =============================================================================
; ВРЕМЕННЫЕ СИСТЕМНЫЕ СТРУКТУРЫ ДАННЫХ ДЛЯ ОТКРЫТИЯ ФАЙЛОВ (ОЗУ RING 0)
; =============================================================================
OPEN_FLAGS_BUF:        DB 00H
OPEN_ALLOCATED_FD:     DB 00H
OPEN_SYS_FILE_IDX:     DB 00H
OPEN_CURRENT_PCB_PTR:  DW 0000H

; =============================================================================
; ВРЕМЕННЫЕ СТРУКТУРЫ ДАННЫХ ЯДРА ДЛЯ ЗАКРЫТИЯ ФАЙЛОВ (ОЗУ RING 0)
; =============================================================================
CLOSE_SYS_FILE_IDX: DB 00H

; =============================================================================
; ВРЕМЕННЫЕ СТРУКТУРЫ ДАННЫХ ЯДРА ДЛЯ СМЕНЫ ДИРЕКТОРИИ (ОЗУ RING 0)
; =============================================================================
CHDIR_TEMP_INODE_L: DB 00H
CHDIR_TEMP_INODE_H: DB 00H

; =============================================================================
; ВРЕМЕННЫЕ СТРУКТУРЫ ДАННЫХ ЯДРА ДЛЯ POSIX БУДИЛЬНИКОВ (ОЗУ RING 0)
; =============================================================================
ALARM_OLD_SEC_RES: DB 00H
ALARM_NEW_TICKS:   DW 0000H

; =============================================================================
; ВРЕМЕННЫЕ СТРУКТУРЫ ДАННЫХ ЯДРА ДЛЯ РЕГИСТРАЦИИ СИГНАЛОВ (ОЗУ RING 0)
; =============================================================================
SIG_NUM_BUF:          DB 00H
SIG_NEW_HANDLER_L:    DB 00H
SIG_NEW_HANDLER_H:    DB 00H
SIG_OLD_STRUCT_PTR:   DW 0000H
SIG_PROC_TABLE_PTR:   DW 0000H

; =============================================================================
; ДОПОЛНИТЕЛЬНЫЕ СЛУЖЕБНЫЕ ЯЧЕЙКИ ОЗУ ЯДРА (RING 0)
; =============================================================================
READ_CHAR_CHAR: DB 00H

; =============================================================================
; ВРЕМЕННЫЕ СТРУКТУРЫ ДАННЫХ ВЫЗОВА ОВЕРЛЕЕВ (ОЗУ RING 0)
; =============================================================================
OVL_TARGET_SEG:     DB 00H
OVL_EXT_MAP_IDX:    DB 00H
OVL_PHYS_PAGE_NUM:  DB 00H
OVL_SWAP_MASK_BUF:  DB 00H
OVL_BIT_MASK:       DB 00H
OVL_NEW_FRAME_NUM:  DB 00H
OVL_CURRENT_PCB:    DW 0000H